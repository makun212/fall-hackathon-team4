GEMINI_API_KEY=
# 使うモデルを変えるときだけ、先頭の # を外して書く（書かなければ ai.py の DEFAULT_MODEL）
# GEMINI_MODEL=
# 使うモデルが混み合っているときに、1回だけやり直す予備のモデル（書かなければ ai.py の DEFAULT_FALLBACK_MODEL。空にするとやり直さない）
# GEMINI_FALLBACK_MODEL=
# アプリ全体で1分にAIを呼べる回数を変えるときだけ書く（書かなければ chat.py の 30）
# CHAT_LIMIT_PER_MINUTE=

# ---- Googleログイン（#33） ----
# Google Cloud の「OAuth クライアント ID」（ウェブアプリケーション）で作った値
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 本番でリダイレクト先が http になってしまうときだけ書く（例: https://example.com/auth/google/callback）
# GOOGLE_REDIRECT_URI=
# 先生になるための合言葉。チームと審査員にだけ伝える
TEACHER_CODE=
# ログイン状態を署名する鍵。本番では必ず長いランダムな文字列を書く（python -c "import secrets; print(secrets.token_urlsafe(32))"）
SESSION_SECRET=
# 本番（https）では 1 にする
# SESSION_HTTPS_ONLY=1
# 開発用ログイン（Google の設定なしで手元で試す）。本番では絶対に書かない
# DEV_LOGIN=1
